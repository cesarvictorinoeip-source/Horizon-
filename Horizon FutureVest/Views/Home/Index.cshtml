@using Application.ViewModels
@model HomeRankingViewModel

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-bar-chart-fill me-2"></i>
            <h4 class="mb-0">Ranking de Países</h4>
        </div>
        <div class="card-body">

            <!-- Selector de Año -->
            <form asp-action="Index" method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label for="SelectedYear" class="form-label fw-bold">
                        <i class="bi bi-calendar-event me-1"></i> Año
                    </label>
                    <select asp-for="SelectedYear" asp-items="Model.AvailableYears" class="form-select"></select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-play-fill me-1"></i> Obtener Ranking
                    </button>
                </div>
            </form>

            <!-- Validaciones -->
            @if (!Model.PesosValidos || !string.IsNullOrEmpty(Model.ValidationMessage))
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>@Model.ValidationMessage</div>
                </div>
            }

            <!-- Tabla de Ranking -->
            @if (Model.Ranking != null && Model.Ranking.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="bi bi-flag me-1"></i> País</th>
                                <th><i class="bi bi-code me-1"></i> Código ISO</th>
                                <th><i class="bi bi-graph-up-arrow me-1"></i> Scoring</th>
                                <th><i class="bi bi-currency-dollar me-1"></i> Tasa de Retorno</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Ranking)
                            {
                                <tr>
                                    <td>@item.CountryName</td>
                                    <td>@item.IsoCode</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.Scoring
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">
                                            @item.ReturnRate %
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div>No hay datos disponibles para el año seleccionado.</div>
                </div>
            }
        </div>
    </div>
</div>