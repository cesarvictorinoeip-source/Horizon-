@model Application.ViewModels.Simulacion2._0.EditarSimulacionMacroindicadorViewModel
@{
    ViewData["Title"] = "Editar Macroindicador de Simulación";
}

<h2>Editar Macroindicador</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Macroindicador</label>
        <input type="text" class="form-control" value="@Model.Name" disabled />
    </div>

    <div class="form-group">
        <label for="PesoSimulacion">Nuevo Peso</label>
        <input asp-for="PesoSimulacion" class="form-control" type="number" step="0.0001" min="0.0001" max="1.0000" />
        <span asp-validation-for="PesoSimulacion" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        <button type="submit" class="btn btn-success">Guardar Cambios</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}