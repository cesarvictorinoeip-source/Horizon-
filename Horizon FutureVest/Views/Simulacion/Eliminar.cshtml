@model Application.ViewModels.Simulacion2._0.SimulacionMacroindicadorViewModel
@{
    ViewData["Title"] = "Eliminar Macroindicador de Simulación";
}

<h2>Eliminar Macroindicador</h2>

<div class="alert alert-danger">
    <strong>¿Está seguro que desea eliminar este macroindicador de la simulación?</strong>
</div>

<div class="mb-3">
    <p><strong>Nombre:</strong> @Model.Name</p>
    <p><strong>Peso:</strong> @Model.PesoSimulacion</p>
</div>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">Eliminar</button>
    </div>
</form>