@model Application.ViewModels.Simulacion2._0.AgregarSimulacionMacroindicadorViewModel
@{
    ViewData["Title"] = "Agregar Macroindicador a Simulación";
}

<h2>Agregar Macroindicador a Simulación</h2>

<form asp-action="Agregar" method="post">
    <div class="form-group">
        <label for="MacroindicadorId">Macroindicador</label>
        <select asp-for="MacroindicadorId" asp-items="Model.MacroindicadoresDisponibles" class="form-control"></select>
        <span asp-validation-for="MacroindicadorId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="PesoSimulacion">Peso</label>
        <input asp-for="PesoSimulacion" class="form-control" type="number" step="0.0001" min="0.0001" max="1.0000" />
        <span asp-validation-for="PesoSimulacion" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        <button type="submit" class="btn btn-primary">Agregar</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}