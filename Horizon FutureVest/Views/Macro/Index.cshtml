@model IEnumerable<Application.ViewModels.MacroindicadorViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Macroindicadores";

    // Lógica para la mejora de pesos
    var totalPeso = Model?.Sum(x => x.Peso) ?? 0;
    var porcentajeTotal = totalPeso * 100;

    // Cambia el color según el estado de la suma
    var colorBarra = totalPeso > 1 ? "bg-danger" : (totalPeso == 1 ? "bg-success" : "bg-info");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-list-stars text-success"></i> Gestión de Macroindicadores
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo Macroindicador
        </a>
    </div>

    @* --- MEJORA: BARRA DE CONTROL DE PESOS --- *@
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-secondary">Distribución Total de Pesos</span>
                <span class="badge @(totalPeso > 1 ? "bg-danger" : "bg-dark") fs-6 shadow-sm">
                    @porcentajeTotal.ToString("N1")% / 100%
                </span>
            </div>
            <div class="progress" style="height: 12px; border-radius: 10px;">
                <div class="progress-bar @colorBarra progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: @(porcentajeTotal > 100 ? 100 : porcentajeTotal)%;">
                </div>
            </div>
            @if (totalPeso < 1)
            {
                <div class="mt-2 small text-muted">
                    <i class="bi bi-info-circle-fill text-info"></i>
                    Tienes disponible el <strong>@((1 - totalPeso) * 100)%</strong> para nuevos macroindicadores.
                </div>
            }
            else if (totalPeso > 1)
            {
                <div class="mt-2 small text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    ¡Atención! La suma de pesos excede el 100%. Debes editar los valores.
                </div>
            }
        </div>
    </div>
    @* ----------------------------------------- *@

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Nombre del Macroindicador</th>
                        <th class="text-center">Peso</th>
                        <th class="text-center">Tendencia Ideal</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Nombre</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(item.Peso * 100)% (@item.Peso)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.MasAltoMejor)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info">
                                            <i class="bi bi-graph-up-arrow"></i> Más alto es mejor
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning">
                                            <i class="bi bi-graph-down-arrow"></i> Más bajo es mejor
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">Activo</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                No hay macroindicadores configurados en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>