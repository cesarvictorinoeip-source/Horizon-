@model Application.ViewModels.ReturnRate.ReturnRateViewModels

@{
    ViewData["Title"] = "Nueva Tasa de Retorno";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px; border-radius: 15px;">
        <div class="card-header bg-primary text-white fw-bold text-center" style="border-radius: 15px 15px 0 0;">
            <h4 class="mb-0">Registrar Nueva Tasa</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nombre del Rango</label>
                    <input asp-for="Name" class="form-control" placeholder="Ej: Bajo Riesgo" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="MinRate" class="form-label fw-bold">Mínimo</label>
                        <input asp-for="MinRate" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxRate" class="form-label fw-bold">Máximo</label>
                        <input asp-for="MaxRate" type="number" step="0.01" class="form-control" />
                    </div>
                </div>
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-primary fw-bold">Guardar Tasa</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>