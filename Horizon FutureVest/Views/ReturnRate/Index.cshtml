@model Application.ViewModels.ReturnRate.ReturnRateViewModels

<div class="container mt-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">Configuración de Tasas de Retorno</h4>
        </div>
        <div class="card-body p-4">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Index" method="post">
                @* Resumen de validación para errores generales *@
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Name" />

                <div class="mb-3">
                    <label asp-for="MinRate" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="MinRate" type="number" step="0.01" class="form-control" placeholder="Ej: 5.0" />
                        <span class="input-group-text">%</span>
                    </div>
                    @* AQUÍ SE MUESTRA EL ERROR DE LA TASA MÍNIMA *@
                    <span asp-validation-for="MinRate" class="text-danger fw-bold small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MaxRate" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="MaxRate" type="number" step="0.01" class="form-control" placeholder="Ej: 15.0" />
                        <span class="input-group-text">%</span>
                    </div>
                    @* AQUÍ SE MUESTRA EL ERROR DE LA TASA MÁXIMA *@
                    <span asp-validation-for="MaxRate" class="text-danger fw-bold small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    @* Botón que devuelve al Home según el mandato *@
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Volver Atrás
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        Guardar Tasas
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        @* Carga los scripts necesarios para que la validación funcione en el cliente *@
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}